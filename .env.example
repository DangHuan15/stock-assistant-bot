# =====================================================================
# CẤU HÌNH BOT TELEGRAM CHỨNG KHOÁN VIỆT NAM (STOCK BOT)
# =====================================================================
# HƯỚNG DẪN:
# 1. Đổi tên file này từ ".env.example" thành ".env" (hoặc sao chép file này tạo thành file .env mới).
# 2. Điền các mã khóa API của bạn vào sau dấu bằng (=).
# 3. LƯU Ý: Tuyệt đối KHÔNG chia sẻ file .env của bạn cho người khác hoặc đẩy lên GitHub!
# =====================================================================

# 1. TOKEN BOT TELEGRAM
# Lấy từ Telegram: Chat với bot @BotFather -> gõ /newbot -> làm theo hướng dẫn để lấy Token.
# Ví dụ: 1234567890:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. KHÓA KẾT NỐI API CHỨNG KHOÁN DNSE
# Lấy từ: Đăng nhập tài khoản tại DNSE (https://dnse.com.vn) -> Quản lý tài khoản -> Tạo/Lấy API Key & Secret.
DNSE_API_KEY=your_dnse_api_key_here
DNSE_API_SECRET=your_dnse_api_secret_here

# 3. CHẾ ĐỘ DEBUG
# Để "false" khi bot vận hành thực tế.
DEBUG=false

# 4. QUY ĐỔI ĐƠN VỊ GIÁ
# Giữ mặc định 1000 (DNSE tính theo nghìn đồng/cổ phiếu).
DNSE_PRICE_TO_VND=1000
VNSTOCK_PRICE_TO_VND=1000
